<div class="oh-section">
  <div class="oh-coll-head">
    <h1>{{ collection.title | upcase }}</h1>
    <div style="display:flex;align-items:center;gap:14px">
      <span class="oh-count">{{ collection.products_count }} ITEMS</span>
      <form method="get" action="{{ collection.url }}">
        <select class="oh-sort" name="sort_by" onchange="this.form.submit()" aria-label="Sort by">
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name | upcase }}</option>
          {% endfor %}
        </select>
      </form>
    </div>
  </div>

  {% if collection.description != blank %}
    <div class="oh-rte" style="max-width:560px;margin:-14px 0 30px">{{ collection.description }}</div>
  {% endif %}

  {% paginate collection.products by 24 %}
    <div class="oh-grid">
      {% for card_product in collection.products %}
        {% render 'product-card', card_product: card_product %}
      {% else %}
        <p class="oh-note">NO PRODUCTS IN THIS COLLECTION YET</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <nav class="oh-pager">
        {% if paginate.previous %}<a href="{{ paginate.previous.url }}">← PREV</a>{% endif %}
        {% for part in paginate.parts %}
          {% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>
          {% else %}<span class="oh-cur">{{ part.title }}</span>{% endif %}
        {% endfor %}
        {% if paginate.next %}<a href="{{ paginate.next.url }}">NEXT →</a>{% endif %}
      </nav>
    {% endif %}
  {% endpaginate %}
</div>

{% schema %}
{ "name": "Collection grid", "settings": [] }
{% endschema %}
