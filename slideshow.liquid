{%- assign sid = section.id -%}
<div class="oh-slideshow" data-slideshow data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}">
  <div class="oh-slides">
    {% for block in section.blocks %}
      <div class="oh-slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
        {% if block.settings.image %}
          {%- assign img = block.settings.image -%}
          {%- capture sizes -%}(max-width: 749px) 100vw, 100vw{%- endcapture -%}
          <img
            src="{{ img | image_url: width: 1600 }}"
            srcset="{{ img | image_url: width: 400 }} 400w,
                    {{ img | image_url: width: 600 }} 600w,
                    {{ img | image_url: width: 800 }} 800w,
                    {{ img | image_url: width: 1000 }} 1000w,
                    {{ img | image_url: width: 1200 }} 1200w,
                    {{ img | image_url: width: 1400 }} 1400w,
                    {{ img | image_url: width: 1600 }} 1600w,
                    {{ img | image_url: width: 1800 }} 1800w,
                    {{ img | image_url: width: 2000 }} 2000w,
                    {{ img | image_url: width: 2200 }} 2200w"
            sizes="{{ sizes }}"
            width="{{ img.width }}"
            height="{{ img.height }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            {% if forloop.first %}fetchpriority="high"{% endif %}>
        {% endif %}

        {% if block.settings.mobile_image %}
          {%- assign mimg = block.settings.mobile_image -%}
          <img class="oh-slide-mobile"
            src="{{ mimg | image_url: width: 1000 }}"
            srcset="{{ mimg | image_url: width: 400 }} 400w,
                    {{ mimg | image_url: width: 600 }} 600w,
                    {{ mimg | image_url: width: 800 }} 800w,
                    {{ mimg | image_url: width: 1000 }} 1000w"
            sizes="100vw"
            alt="{{ mimg.alt | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
        {% endif %}

        {% if block.settings.heading != blank or block.settings.button_label != blank %}
          <div class="oh-slide-text">
            {% if block.settings.heading != blank %}<h2 class="oh-slide-h">{{ block.settings.heading }}</h2>{% endif %}
            {% if block.settings.button_label != blank %}
              <a class="oh-hero-cta oh-slide-cta" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="oh-slide is-active" data-slide>
        <div class="oh-slide-ph"></div>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <button class="oh-arrow oh-arrow--prev" type="button" data-prev aria-label="Previous slide">‹</button>
    <button class="oh-arrow oh-arrow--next" type="button" data-next aria-label="Next slide">›</button>
    <div class="oh-dots" data-dots>
      {% for block in section.blocks %}
        <button class="oh-dot{% if forloop.first %} is-active{% endif %}" type="button" data-dot="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Slideshow",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 3, "max": 12, "step": 1, "default": 6, "unit": "s" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
        { "type": "image_picker", "id": "mobile_image", "label": "Image (mobile, optional)" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "EXPLORE DROP 04" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [{ "name": "Slideshow", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}
