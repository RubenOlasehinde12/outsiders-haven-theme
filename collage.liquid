{%- liquid
  assign s = section.settings
-%}
<div class="oh-section" style="padding-top:{{ s.pad_top }}px;padding-bottom:{{ s.pad_bottom }}px">
  {% if s.title != blank %}<h2 class="oh-sec-title" style="text-align:{{ s.title_align }}">{{ s.title }}</h2>{% endif %}
  <div class="oh-collage" style="--oh-collage-cols:{{ s.columns }}">
    {% for block in section.blocks %}
      {%- assign b = block.settings -%}
      <a class="oh-collage-cell{% if b.large %} oh-collage-cell--lg{% endif %}"
         href="{{ b.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {% if b.image %}
          {{ b.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: b.caption | escape }}
        {% else %}
          <div class="oh-collage-ph"></div>
        {% endif %}
        {% if b.caption != blank %}<span class="oh-collage-cap">{{ b.caption }}</span>{% endif %}
      </a>
    {% else %}
      {% for i in (1..3) %}<div class="oh-collage-cell"><div class="oh-collage-ph"></div></div>{% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Lookbook collage",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "LOOKBOOK" },
    { "type": "select", "id": "title_align", "label": "Heading alignment", "default": "center",
      "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }] },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "image", "name": "Image", "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption (optional)" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "large", "label": "Make this tile large", "default": false }
      ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Lookbook collage", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
