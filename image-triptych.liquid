<div class="oh-triptych">
  {% for block in section.blocks %}
    <div {{ block.shopify_attributes }}>
      {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" style="display:block;height:100%">{% endif %}
      {% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '' }}{% endif %}
      {% if block.settings.link != blank %}</a>{% endif %}
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Image triptych",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Image triptych", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
