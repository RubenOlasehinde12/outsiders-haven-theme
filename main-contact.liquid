{%- liquid
  assign s = section.settings
-%}
<div class="oh-page oh-contact">
  <h1>{{ page.title | default: s.heading | upcase }}</h1>

  {% if s.intro != blank %}
    <div class="oh-rte oh-contact-intro">{{ s.intro }}</div>
  {% endif %}

  <div class="oh-contact-grid">
    <div class="oh-contact-form">
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <p class="oh-note">{{ s.success_text }}</p>
        {% endif %}
        {% if form.errors %}
          <p class="oh-note">{{ form.errors | default_errors }}</p>
        {% endif %}
        <input class="oh-input" type="text" name="contact[name]" placeholder="{{ s.name_label }}" value="{% if form.name %}{{ form.name }}{% endif %}" required>
        <input class="oh-input" type="email" name="contact[email]" placeholder="{{ s.email_label }}" value="{% if form.email %}{{ form.email }}{% endif %}" required>
        <input class="oh-input" type="text" name="contact[subject]" placeholder="{{ s.subject_label }}">
        <textarea class="oh-input oh-textarea" name="contact[body]" placeholder="{{ s.message_label }}" rows="6" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        <button class="oh-btn oh-btn-block" type="submit">{{ s.button_label }}</button>
      {% endform %}
    </div>

    {% if s.details != blank %}
      <aside class="oh-contact-details oh-rte">{{ s.details }}</aside>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "CONTACT" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Questions about an order, sizing, or a drop? Send a message and we'll get back to you within 1–2 business days.</p>" },
    { "type": "header", "content": "Form labels" },
    { "type": "text", "id": "name_label", "label": "Name placeholder", "default": "NAME" },
    { "type": "text", "id": "email_label", "label": "Email placeholder", "default": "EMAIL" },
    { "type": "text", "id": "subject_label", "label": "Subject placeholder", "default": "SUBJECT" },
    { "type": "text", "id": "message_label", "label": "Message placeholder", "default": "MESSAGE" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SEND MESSAGE" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "THANKS — YOUR MESSAGE HAS BEEN SENT. WE'LL BE IN TOUCH SOON." },
    { "type": "header", "content": "Contact details (optional sidebar)" },
    { "type": "richtext", "id": "details", "label": "Details", "default": "<p><strong>EMAIL</strong><br>outsidershvn@gmail.com</p><p><strong>RESPONSE TIME</strong><br>1–2 business days</p><p><strong>SOCIAL</strong><br>@outsidershaven</p>" }
  ]
}
{% endschema %}
