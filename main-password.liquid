{%- liquid
  assign s = section.settings
-%}
<div class="oh-gate{% if s.bg_image %} oh-gate--image{% endif %}"
     style="--oh-gate-logo-size:{{ s.logo_size | default: 20 }};--oh-gate-btn-bg:{{ s.btn_bg | default: '#FFFFFF' }};--oh-gate-btn-text:{{ s.btn_text | default: '#0B0B0D' }};--oh-gate-btn-border:{{ s.btn_border | default: '#FFFFFF' }};--oh-gate-input-bg:{{ s.input_bg | default: '#FFFFFF' }};--oh-gate-input-text:{{ s.input_text | default: '#0B0B0D' }};--oh-gate-input-placeholder:{{ s.input_placeholder | default: '#6B6B6B' }};--oh-gate-input-border:{{ s.input_border | default: '#0B0B0D' }};--oh-gate-input-radius:{{ s.input_radius | default: 2 }}px;{% if s.bg_image %}background-image:linear-gradient(rgba(0,0,0,{{ s.overlay | divided_by: 100.0 }}),rgba(0,0,0,{{ s.overlay | divided_by: 100.0 }})),url('{{ s.bg_image | image_url: width: 2000 }}');{% else %}background:{{ s.bg_color | default: '#ffffff' }};{% endif %}color:{{ s.text_color | default: '#111111' }}">
  {% if s.logo %}
    {{ s.logo | image_url: width: 600 | image_tag: alt: shop.name, class: 'oh-gate-logo', style: 'height:auto;width:auto;max-height:calc(var(--oh-gate-logo-size, 20) * 1px);max-width:80%' }}
  {% elsif shop.brand.logo %}
    {{ shop.brand.logo | image_url: width: 600 | image_tag: alt: shop.name, class: 'oh-gate-logo', style: 'height:auto;width:auto;max-height:calc(var(--oh-gate-logo-size, 20) * 1px);max-width:80%' }}
  {% else %}
    <div class="oh-logo-text">{{ shop.name | upcase }}</div>
  {% endif %}

  <h1 class="oh-gate-title">{{ s.heading }}</h1>
  {% if s.subheading != blank %}<p class="oh-gate-sub">{{ s.subheading }}</p>{% endif %}

  <div id="oh-signup">
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="{{ s.signup_tags }}">
      <div class="oh-input-prefixed">
        {% if s.email_prefix != blank %}<span class="oh-input-prefix">{{ s.email_prefix }}</span>{% endif %}
        <input class="oh-input" type="email" name="contact[email]" placeholder="{{ s.email_placeholder }}" required>
      </div>
      <button class="oh-btn oh-btn-block" type="submit">{{ s.signup_button }}</button>
      {% if form.posted_successfully? %}<p class="oh-note">{{ s.success_text }}</p>{% endif %}
      {% if form.errors %}<p class="oh-note">CHECK YOUR DETAILS AND TRY AGAIN</p>{% endif %}
      {% if s.fine_print != blank %}<p class="oh-fine">{{ s.fine_print }}</p>{% endif %}
    {% endform %}
    <button class="oh-toggle" type="button" onclick="document.getElementById('oh-signup').classList.add('oh-hidden');document.getElementById('oh-pass').classList.remove('oh-hidden')">{{ s.password_toggle }}</button>
  </div>

  <div id="oh-pass" class="oh-hidden">
    {% form 'storefront_password' %}
      <input class="oh-input" type="password" name="password" placeholder="{{ s.password_placeholder | default: 'MEMBER ACCESS CODE' }}" autocomplete="current-password">
      <button class="oh-btn oh-btn-block" type="submit">{{ s.password_button | default: 'MEMBERS ENTER' }}</button>
      {% if form.errors %}<p class="oh-note">WRONG PASSWORD — TRY AGAIN</p>{% endif %}
    {% endform %}
    <button class="oh-toggle" type="button" onclick="document.getElementById('oh-pass').classList.add('oh-hidden');document.getElementById('oh-signup').classList.remove('oh-hidden')">← BACK TO SIGN UP</button>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "header", "content": "Logo & background" },
    { "type": "image_picker", "id": "logo", "label": "Logo (optional)" },
    { "type": "range", "id": "logo_size", "label": "Logo size", "min": 20, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)" },
    { "type": "range", "id": "overlay", "label": "Background darkening", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 45 },
    { "type": "color", "id": "bg_color", "label": "Background colour (if no image)", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#111111" },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "JOIN THE HAVEN" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Drops, restocks and early-access — straight to your inbox." },
    { "type": "header", "content": "Signup form" },
    { "type": "text", "id": "email_prefix", "label": "Field prefix label", "default": "EMAIL:", "info": "Stays visible while the customer types. Leave blank for no prefix." },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "rubenolasehinde56@gmail.com" },
    { "type": "header", "content": "Buttons (Join & Members Enter)" },
    { "type": "color", "id": "btn_bg", "label": "Button fill", "default": "#FFFFFF" },
    { "type": "color", "id": "btn_text", "label": "Button text", "default": "#0B0B0D" },
    { "type": "color", "id": "btn_border", "label": "Button border", "default": "#FFFFFF" },
    { "type": "header", "content": "Email field style" },
    { "type": "color", "id": "input_bg", "label": "Field fill", "default": "#FFFFFF" },
    { "type": "color", "id": "input_text", "label": "Typed text colour", "default": "#0B0B0D" },
    { "type": "color", "id": "input_placeholder", "label": "Placeholder text colour", "default": "#6B6B6B" },
    { "type": "color", "id": "input_border", "label": "Border colour", "default": "#0B0B0D" },
    { "type": "range", "id": "input_radius", "label": "Corner radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 2 },
    { "type": "text", "id": "signup_button", "label": "Signup button", "default": "JOIN — GET ACCESS" },
    { "type": "text", "id": "signup_tags", "label": "Customer tags applied on signup", "default": "waitlist,sanctum-drop", "info": "Tags let you filter your waitlist in Shopify Customers. Separate multiple tags with commas." },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "YOU'RE IN — WATCH YOUR MESSAGES" },
    { "type": "text", "id": "password_toggle", "label": "Owner-entry button label", "default": "MEMBERS — ENTER" },
    { "type": "text", "id": "password_placeholder", "label": "Access field placeholder", "default": "MEMBER ACCESS CODE" },
    { "type": "text", "id": "password_button", "label": "Access submit button", "default": "MEMBERS ENTER" },
    { "type": "richtext", "id": "fine_print", "label": "Fine print", "default": "<p>By joining you agree to receive email marketing. Unsubscribe anytime.</p>" }
  ]
}
{% endschema %}
