{%- liquid
  assign s = section.settings
  assign posmap = 'top-left:flex-start flex-start,top-center:flex-start center,top-right:flex-start flex-end,center-left:center flex-start,center-center:center center,center-right:center flex-end,bottom-left:flex-end flex-start,bottom-center:flex-end center,bottom-right:flex-end flex-end'
-%}
{%- capture align -%}
  {%- case s.content_position -%}
    {%- when 'top-left' -%}justify-content:flex-start;align-items:flex-start;text-align:left
    {%- when 'top-center' -%}justify-content:flex-start;align-items:center;text-align:center
    {%- when 'top-right' -%}justify-content:flex-start;align-items:flex-end;text-align:right
    {%- when 'center-left' -%}justify-content:center;align-items:flex-start;text-align:left
    {%- when 'center-center' -%}justify-content:center;align-items:center;text-align:center
    {%- when 'center-right' -%}justify-content:center;align-items:flex-end;text-align:right
    {%- when 'bottom-center' -%}justify-content:flex-end;align-items:center;text-align:center
    {%- when 'bottom-right' -%}justify-content:flex-end;align-items:flex-end;text-align:right
    {%- else -%}justify-content:flex-end;align-items:flex-start;text-align:left
  {%- endcase -%}
{%- endcapture -%}
<div class="oh-hero" style="height:{{ s.height }}svh;{% if s.grayscale %}--oh-hero-filter:grayscale(1);{% else %}--oh-hero-filter:none;{% endif %}">
  {% if s.image %}
    {{ s.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: s.heading | default: shop.name }}
  {% endif %}
  {% if s.overlay > 0 %}<div class="oh-hero-overlay" style="opacity:{{ s.overlay | divided_by: 100.0 }}"></div>{% endif %}
  <div class="oh-hero-inner" style="{{ align }};color:{{ s.text_color | default: '#ffffff' }}">
    {% if s.subheading != blank %}<p class="oh-hero-sub">{{ s.subheading }}</p>{% endif %}
    {% if s.heading != blank %}<h1 class="oh-hero-h">{{ s.heading }}</h1>{% endif %}
    {% if s.button_label != blank %}
      <a class="oh-hero-cta" style="position:static;margin-top:22px" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "checkbox", "id": "grayscale", "label": "Grayscale image", "default": false },
    { "type": "range", "id": "overlay", "label": "Image darkening", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 20 },
    { "type": "range", "id": "height", "label": "Height", "min": 40, "max": 100, "step": 5, "unit": "vh", "default": 100 },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "subheading", "label": "Small heading (eyebrow)", "default": "COLLECTION 001" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "SANCTUM" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#ffffff" },
    { "type": "select", "id": "content_position", "label": "Text position", "default": "bottom-left",
      "options": [
        { "value": "top-left", "label": "Top left" }, { "value": "top-center", "label": "Top center" }, { "value": "top-right", "label": "Top right" },
        { "value": "center-left", "label": "Middle left" }, { "value": "center-center", "label": "Middle center" }, { "value": "center-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom center" }, { "value": "bottom-right", "label": "Bottom right" }
      ]
    },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "EXPLORE THE DROP" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
