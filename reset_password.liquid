<div class="oh-form">
  <h1>RESET PASSWORD</h1>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <div class="oh-field"><label for="np">NEW PASSWORD</label><input class="oh-input" id="np" type="password" name="customer[password]"></div>
    <div class="oh-field"><label for="nc">CONFIRM</label><input class="oh-input" id="nc" type="password" name="customer[password_confirmation]"></div>
    <button class="oh-btn oh-btn-block" type="submit">RESET</button>
  {% endform %}
</div>
