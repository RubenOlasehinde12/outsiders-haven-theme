{% doc %}
  @prompt
    Create a slideshow image that shows all the photos all at once instead of one by one , No make it horizontal , Make it move by itself 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-auto-scroll-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    overflow: hidden;
  }

  .ai-auto-scroll-gallery__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    width: fit-content;
  }

  .ai-auto-scroll-gallery__container-{{ ai_gen_id }}.animate {
    animation: ai-auto-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-auto-scroll-gallery__container-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  @keyframes ai-auto-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-auto-scroll-gallery__item-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_width }}px;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-auto-scroll-gallery__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: {{ block.settings.aspect_ratio }};
  }

  .ai-auto-scroll-gallery__placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-auto-scroll-gallery__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .ai-auto-scroll-gallery__item-{{ ai_gen_id }} {
      width: {{ block.settings.image_width_mobile }}px;
    }
  }
{% endstyle %}

<auto-scroll-gallery-{{ ai_gen_id }} class="ai-auto-scroll-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-auto-scroll-gallery__container-{{ ai_gen_id }}">
    {% for i in (1..12) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign image = block.settings[image_key]
      %}
      
      {% if image != blank %}
        <div class="ai-auto-scroll-gallery__item-{{ ai_gen_id }}">
          <img
            src="{{ image | image_url: width: 800 }}"
            alt="{{ image.alt | escape }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
            class="ai-auto-scroll-gallery__image-{{ ai_gen_id }}"
          >
        </div>
      {% elsif i <= 6 %}
        <div class="ai-auto-scroll-gallery__item-{{ ai_gen_id }}">
          <div class="ai-auto-scroll-gallery__placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</auto-scroll-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class AutoScrollGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.container = this.querySelector('.ai-auto-scroll-gallery__container-{{ ai_gen_id }}');
        this.items = Array.from(this.querySelectorAll('.ai-auto-scroll-gallery__item-{{ ai_gen_id }}'));
        
        if (this.items.length > 0) {
          this.duplicateItems();
          this.container.classList.add('animate');
        }
      }

      duplicateItems() {
        const fragment = document.createDocumentFragment();
        this.items.forEach(item => {
          const clone = item.cloneNode(true);
          fragment.appendChild(clone);
        });
        this.container.appendChild(fragment);
      }
    }

    customElements.define('auto-scroll-gallery-{{ ai_gen_id }}', AutoScrollGallery{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Auto scroll gallery",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width on desktop",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "label": "Image width on mobile",
      "min": 150,
      "max": 400,
      "step": 25,
      "unit": "px",
      "default": 250
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
